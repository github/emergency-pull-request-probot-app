# For local dev only
WEBHOOK_PROXY_URL=
# GitHub App
APP_ID=
WEBHOOK_SECRET=
PRIVATE_KEY=
# Optional fallback for missing GitHub App credentials (requires AWS credentials/region)
GITHUB_APP_SECRET_ARN=
# Slack App
SLACK_BOT_TOKEN=
# Functionality flags
APPROVE_PR=true
CREATE_ISSUE=true
MERGE_PR=true
SLACK_NOTIFY=true
EMERGENCY_LABEL_PERMANENT=true
# Content controls
ISSUE_TITLE=Emergency PR Audit
ISSUE_BODY_FILE=issueBody.md
ISSUE_ASSIGNEES=
EMERGENCY_LABEL=emergency
TRIGGER_STRING=emergency landing
SLACK_CHANNEL_ID=
SLACK_MESSAGE_FILE=slackMessage.txt
# Authorization. Members of this team are allowed to trigger the app. The app's
# own bot is auto-detected and allowlisted; other bots in the org cannot bypass.
AUTHORIZED_TEAM=